{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "@configs/tailwind": ["dropshot-pilot/verify/shims/configs-tailwind.ts"],
      "react": ["apps/v4/node_modules/react/index.js"],
      "react/jsx-runtime": ["apps/v4/node_modules/react/jsx-runtime.js"],
      "react-dom/server": ["apps/v4/node_modules/react-dom/server.js"],
      "@base-ui/react/*": ["apps/v4/node_modules/@base-ui/react/*"],
      "@base-ui/react": ["apps/v4/node_modules/@base-ui/react"],
      "lucide-react": ["apps/v4/node_modules/lucide-react"],
      "clsx": ["apps/v4/node_modules/clsx/dist/clsx.mjs"],
      "tailwind-merge": ["apps/v4/node_modules/tailwind-merge/dist/bundle-mjs.mjs"],
      "class-variance-authority": [
        "apps/v4/node_modules/class-variance-authority/dist/index.mjs"
      ]
    }
  },
  "include": ["*.mts", "../packages/design-system/components/**/*.tsx"]
}
